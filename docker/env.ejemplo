# Configuración para Docker. Cópialo en la raíz del proyecto como .env.docker y completa los valores:
#   cp docker/env.ejemplo .env.docker && chmod 600 .env.docker
# .env.docker NUNCA se sube a GitHub (ya está en .gitignore como .env.*).
# Generar claves:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# ── Django ─────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kpi.adzone.marketing
CSRF_ORIGINS=https://kpi.adzone.marketing
# Saltos de proxy delante de la app (nginx/Plesk = 1). Sirve para el límite de intentos de entrada.
NUM_PROXIES=1

# ── Base de datos (MariaDB del docker-compose) ─────────────────────────
# DB_* los usa la app; MARIADB_* crean la base la primera vez. Pon los MISMOS valores.
DB_NAME=adzone_team
DB_USER=adzone_team
DB_PASSWORD=
MARIADB_DATABASE=adzone_team
MARIADB_USER=adzone_team
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# ── Respaldos cifrados (servicio «tareas», 2:30 a. m.) ─────────────────
# GUÁRDALA TAMBIÉN FUERA DEL SERVIDOR: sin ella no se abre ningún respaldo.
RESPALDO_CLAVE=

# ── Opcionales (ver backend/.env.example para el detalle) ──────────────
# AUTOMATIZACIONES_SECRETO=
# ANTHROPIC_API_KEY=
# IA_MODELO=claude-sonnet-5-5
