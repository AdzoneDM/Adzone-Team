# Copia este archivo como backend/.env en el servidor y completa los valores.
# En tu computadora no hace falta: sin DJANGO_SECRET_KEY arranca en modo desarrollo.

# Clave larga y secreta. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=kpi.adzone.marketing
CSRF_ORIGINS=https://kpi.adzone.marketing

# Base de datos. Por defecto SQLite (db.sqlite3). En Plesk se recomienda MariaDB:
# DB_ENGINE=mysql
# DB_NAME=adzone_team
# DB_USER=adzone_team
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=3306

# Carpeta privada de evidencias (fuera de la carpeta pública del sitio)
# MEDIA_ROOT=/var/www/vhosts/adzone.marketing/kpi-privado/evidencias

# Automatizaciones hacia n8n: clave para firmar los webhooks (cabecera X-Adzone-Firma = HMAC-SHA256 del cuerpo).
# En n8n se verifica con la misma clave. Opcional, pero recomendado.
# AUTOMATIZACIONES_SECRETO=

# ---------------------------------------------------------------------------------------------
# Cashflow (facturación fiscal, NCF / e-CF). La API key se genera en Cashflow → Generador de API KEY
# (la app «API-CASHFLOW»). Va SOLO aquí, en el servidor: nunca en GitHub, en el chat ni en la plataforma.
# Sin clave, la integración funciona en «modo prueba» (simulador) y no envía nada.
# CASHFLOW_API_KEY=
# CASHFLOW_API_URL=https://api.cashflow.do
# Cómo se envía la clave. Ajusta según la documentación de desarrolladores de Cashflow:
# CASHFLOW_AUTH_HEADER=Authorization
# CASHFLOW_AUTH_PREFIX=Bearer 
# CASHFLOW_TIMEOUT=20
# Las rutas de cada operación se ajustan en apps/integraciones/cashflow/rutas.py
