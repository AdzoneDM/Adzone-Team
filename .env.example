# Variables del stack (docker-compose.yml). Sin valores reales: en Portainer van en «Environment variables»;
# con «docker compose», en un .env junto al compose (está en .gitignore).

# ── Obligatorias ───────────────────────────────────────────────────────
# Dominio de la app, sin https:// ni barra final
DOMINIO=
# Claves largas y aleatorias, distintas entre sí
DJANGO_SECRET_KEY=
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Cifra los respaldos nocturnos. Guárdala también fuera del servidor: sin ella no se abre ningún respaldo
RESPALDO_CLAVE=

# ── Red ────────────────────────────────────────────────────────────────
# Dónde publica el puerto la app. 127.0.0.1 = solo el proxy del mismo servidor llega a ella
HTTP_BIND=127.0.0.1
PUERTO=8000
# Proxies delante de la app (nginx = 1; Cloudflare + nginx = 2). Afecta al límite de intentos de entrada
NUM_PROXIES=1

# ── Opcionales (vacías = función apagada o valor por defecto) ──────────
AUTOMATIZACIONES_SECRETO=
ANTHROPIC_API_KEY=
IA_MODELO=
VAPID_PUBLICA=
VAPID_PRIVADA=
VAPID_CORREO=
INACTIVIDAD_EMPRESA_MIN=
INACTIVIDAD_MIN=
DOS_PASOS_OBLIGATORIA=
CASHFLOW_API_KEY=
CASHFLOW_API_URL=
GUNICORN_WORKERS=
GUNICORN_TIMEOUT=
